<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.yanimetaxas</groupId>
    <artifactId>bookkeeping-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>bookkeeping-coverage</artifactId>
  <packaging>pom</packaging>
  <name>Bookkeeping Coverage Report</name>
  <description>Aggregates JaCoCo coverage from all modules into one report.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.yanimetaxas</groupId>
      <artifactId>bookkeeping-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.yanimetaxas</groupId>
      <artifactId>bookkeeping-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.yanimetaxas</groupId>
      <artifactId>bookkeeping-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>check</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals><goal>report-aggregate</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
